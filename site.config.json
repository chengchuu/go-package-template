    },
    {
      "name": "examples",
      "outputPath": "examples/index.html",
      "path": "examples/",
      "title": "Go examples | Go Package Template",
      "schemaType": "TechArticle"
    },
    {
      "name": "api",
      "outputPath": "api/index.html",
      "path": "api/",
      "title": "Go API reference | Go Package Template",
      "schemaType": "TechArticle"
    }
  ]
